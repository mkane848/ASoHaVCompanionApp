# Copy to .env and fill in from your Supabase project (Project Settings → API / Database).
# .env is gitignored — never commit real values.

# Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret — bypasses RLS entirely. Server-side only, never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection pooling → URI (session or transaction pooler).
# Used for direct Postgres access (via `pg`) so the Bond handshake can take a real row lock
# instead of a check-then-write that could race under concurrent requests. The direct-connection
# hostname (db.<ref>.supabase.co) is IPv6-only; the shared pooler (aws-*.pooler.supabase.com)
# resolves over IPv4 too and needs no paid add-on.
DATABASE_URL=

WEB_ORIGIN=http://localhost:5173

# Campaign invite emails (0.37.0) — all optional. With RESEND_API_KEY unset, the Resend leg
# no-ops (delivered: false, via: 'none') rather than failing — local dev doesn't need a mail
# provider configured. See CLAUDE.md's invite-email architecture note.
RESEND_API_KEY=
INVITE_FROM_EMAIL=
APP_BASE_URL=http://localhost:5173
