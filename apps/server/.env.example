# Copy to .env and fill in from your Supabase project (Project Settings → API / Database).
# .env is gitignored — never commit real values.

# Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret — bypasses RLS entirely. Server-side only, never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string → URI (Transaction pooling mode).
# Used for direct Postgres access (via `pg`) so the Bond handshake can take a real row lock
# instead of a check-then-write that could race under concurrent requests.
DATABASE_URL=

WEB_ORIGIN=http://localhost:5173
